<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MobAppG4.Views.LoginPage"
    BackgroundColor="#FFF8E1"
    Title="Mano Mano Login">
    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="25" VerticalOptions="CenterAndExpand">

            <Image Source="logo_mano.png" HeightRequest="120" HorizontalOptions="Center" />

            <Label Text="Login to your Account"
                   FontSize="30"
                   FontAttributes="Bold"
                   TextColor="#4E342E"
                   HorizontalOptions="Start" />

            <Frame CornerRadius="10" Padding="10" BackgroundColor="White" HasShadow="False">
                <Entry x:Name="emailEntry"
           Placeholder="Email"
           Keyboard="Email"
           FontSize="17"
           TextColor="#4E342E"
           BackgroundColor="Transparent" />
            </Frame>

            <Entry x:Name="passwordEntry"
                   Placeholder="Password"
                   IsPassword="True"
                   FontSize="17"
                   TextColor="#4E342E"
                   BackgroundColor="White"
                   HeightRequest="45"
                   CornerRadius="10" />

            <Button Text="Sign in"
                    Clicked="OnLoginClicked"
                    BackgroundColor="#D2691E"
                    TextColor="White"
                    CornerRadius="10"
                    FontSize="17"
                    HeightRequest="48" />

            <!-- Sign up link -->
            <HorizontalStackLayout HorizontalOptions="Center">
                <Label Text="Don't have an account?"
                       TextColor="#4E342E"
                       FontSize="14" />
                <Label Text=" Sign up"
                       FontSize="14"
                       TextColor="#D2691E"
                       FontAttributes="Bold">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnRegisterClicked" />
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>

            <!-- OR social login -->
            <Label Text="Or sign in with"
                   FontSize="14"
                   TextColor="#4E342E"
                   HorizontalOptions="Center"
                   Margin="0,10,0,0" />

            <HorizontalStackLayout HorizontalOptions="Center" Spacing="25">
                <Image Source="google.png" HeightRequest="40" WidthRequest="40"/>
                <Image Source="facebook.png" HeightRequest="40" WidthRequest="40"/>
                <Image Source="twitter.png" HeightRequest="40" WidthRequest="40"/>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>