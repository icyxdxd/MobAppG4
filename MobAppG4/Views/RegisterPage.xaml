<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MobAppG4.Views.RegisterPage"
    BackgroundColor="#FFF4E6"
    Title="Register">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="20">

            <Image Source="logo.png" HeightRequest="100" HorizontalOptions="Center" />

            <Label Text="Create your Account"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="Black"
                   HorizontalOptions="Start" />

            <Entry x:Name="emailEntry"
                   Placeholder="Email"
                   Keyboard="Email"
                   FontSize="16"
                   TextColor="Black" />

            <Entry x:Name="passwordEntry"
                   Placeholder="Password"
                   IsPassword="True"
                   FontSize="16"
                   TextColor="Black" />

            <Entry x:Name="confirmPasswordEntry"
                   Placeholder="Confirm Password"
                   IsPassword="True"
                   FontSize="16"
                   TextColor="Black" />

            <Button Text="Sign up"
                    Clicked="OnRegisterClicked"
                    BackgroundColor="#1A237E"
                    TextColor="White"
                    CornerRadius="8"
                    FontSize="16"
                    HeightRequest="45" />

            <!-- OR social signup -->
            <Label Text="Or sign up with"
                   FontSize="14"
                   TextColor="Black"
                   HorizontalOptions="Center"
                   Margin="0,10,0,0" />

            <HorizontalStackLayout HorizontalOptions="Center" Spacing="20">
                <Image Source="google.png" HeightRequest="40" WidthRequest="40"/>
                <Image Source="facebook.png" HeightRequest="40" WidthRequest="40"/>
                <Image Source="twitter.png" HeightRequest="40" WidthRequest="40"/>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>