<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Kalikse.Views.RegisterPage"
    BackgroundColor="#FFF4E6"
    Title="Register">

    <VerticalStackLayout
        Padding="30"
        Spacing="25"
        VerticalOptions="Center"
        HorizontalOptions="Center">

        <Image Source="manomano_logo.png"
               HeightRequest="120"
               HorizontalOptions="Center" />

        <Label Text="Create your ManoMano account"
               FontSize="22"
               FontAttributes="Bold"
               TextColor="#E0A800"
               HorizontalOptions="Center" />

        <Entry x:Name="emailEntry"
               Placeholder="Email"
               Keyboard="Email"
               BackgroundColor="White"
               TextColor="#000"
               Margin="0,10"
               HeightRequest="45" />

        <Entry x:Name="passwordEntry"
               Placeholder="Password"
               IsPassword="True"
               BackgroundColor="White"
               TextColor="#000"
               Margin="0,10"
               HeightRequest="45" />

        <Entry x:Name="confirmPasswordEntry"
               Placeholder="Confirm Password"
               IsPassword="True"
               BackgroundColor="White"
               TextColor="#000"
               Margin="0,10"
               HeightRequest="45" />

        <Button Text="Register"
                Clicked="OnRegisterClicked"
                BackgroundColor="#FF8C42"
                TextColor="White"
                CornerRadius="10"
                HeightRequest="45" />

    </VerticalStackLayout>
</ContentPage>